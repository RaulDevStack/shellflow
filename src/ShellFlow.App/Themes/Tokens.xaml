<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      ShellFlow design tokens. Components reference these semantic keys, never raw hex values.
      Accent brushes are mutated at runtime by ThemeService when the user picks another accent.
    -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <Color x:Key="SfWindowBackgroundColor">#181A20</Color>
            <Color x:Key="SfTerminalBackgroundColor">#111318</Color>
            <SolidColorBrush x:Key="SfWindowBackgroundBrush" Color="#181A20" />
            <SolidColorBrush x:Key="SfSurfaceBrush" Color="#222631" />
            <SolidColorBrush x:Key="SfSurfaceElevatedBrush" Color="#292D38" />
            <SolidColorBrush x:Key="SfTerminalBackgroundBrush" Color="#111318" />
            <SolidColorBrush x:Key="SfTextPrimaryBrush" Color="#F0F0F5" />
            <SolidColorBrush x:Key="SfTextSecondaryBrush" Color="#A0A6B5" />
            <SolidColorBrush x:Key="SfTextTertiaryBrush" Color="#878EA0" />
            <SolidColorBrush x:Key="SfBorderSubtleBrush" Color="#343844" />
            <SolidColorBrush x:Key="SfBorderStrongBrush" Color="#464B59" />
            <SolidColorBrush x:Key="SfHoverBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="SfPressedBrush" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="SfSelectedBrush" Color="#292D38" />
            <SolidColorBrush x:Key="SfAccentBrush" Color="#A6B7FF" />
            <SolidColorBrush x:Key="SfAccentSubtleBrush" Color="#26A6B7FF" />
            <SolidColorBrush x:Key="SfAccentBorderBrush" Color="#99A6B7FF" />
            <SolidColorBrush x:Key="SfOnAccentBrush" Color="#181A20" />
            <SolidColorBrush x:Key="SfSuccessBrush" Color="#A3DCC5" />
            <SolidColorBrush x:Key="SfWarningBrush" Color="#E8BFA6" />
            <SolidColorBrush x:Key="SfErrorBrush" Color="#F2828F" />
            <SolidColorBrush x:Key="SfScrimBrush" Color="#8C0B0C10" />
            <SolidColorBrush x:Key="SfShortcutChipBrush" Color="#2F3340" />

            <!-- Align stock WinUI controls (toggles, checkboxes, dialogs) with the ShellFlow palette. -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#A6B7FF" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6A6B7FF" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CCA6B7FF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#181A20" />
            <SolidColorBrush x:Key="ContentDialogBackground" Color="#222631" />
            <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#222631" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#343844" />
            <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#292D38" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#292D38" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#343844" />
            <SolidColorBrush x:Key="ToolTipBackground" Color="#292D38" />
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#343844" />
            <SolidColorBrush x:Key="ToolTipForeground" Color="#F0F0F5" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <Color x:Key="SfWindowBackgroundColor">#F3F4F7</Color>
            <Color x:Key="SfTerminalBackgroundColor">#FBFBFD</Color>
            <SolidColorBrush x:Key="SfWindowBackgroundBrush" Color="#F3F4F7" />
            <SolidColorBrush x:Key="SfSurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SfSurfaceElevatedBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SfTerminalBackgroundBrush" Color="#FBFBFD" />
            <SolidColorBrush x:Key="SfTextPrimaryBrush" Color="#1A1D24" />
            <SolidColorBrush x:Key="SfTextSecondaryBrush" Color="#545A69" />
            <SolidColorBrush x:Key="SfTextTertiaryBrush" Color="#686E7F" />
            <SolidColorBrush x:Key="SfBorderSubtleBrush" Color="#DCDFE6" />
            <SolidColorBrush x:Key="SfBorderStrongBrush" Color="#C6CAD4" />
            <SolidColorBrush x:Key="SfHoverBrush" Color="#0D1A1D24" />
            <SolidColorBrush x:Key="SfPressedBrush" Color="#081A1D24" />
            <SolidColorBrush x:Key="SfSelectedBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SfAccentBrush" Color="#4A5FC1" />
            <SolidColorBrush x:Key="SfAccentSubtleBrush" Color="#1F4A5FC1" />
            <SolidColorBrush x:Key="SfAccentBorderBrush" Color="#994A5FC1" />
            <SolidColorBrush x:Key="SfOnAccentBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SfSuccessBrush" Color="#257A5A" />
            <SolidColorBrush x:Key="SfWarningBrush" Color="#A35A2E" />
            <SolidColorBrush x:Key="SfErrorBrush" Color="#C23B4B" />
            <SolidColorBrush x:Key="SfScrimBrush" Color="#4D1A1D24" />
            <SolidColorBrush x:Key="SfShortcutChipBrush" Color="#ECEEF2" />

            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#4A5FC1" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E64A5FC1" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC4A5FC1" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ContentDialogBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ContentDialogTopOverlay" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ContentDialogBorderBrush" Color="#DCDFE6" />
            <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#DCDFE6" />
            <SolidColorBrush x:Key="ToolTipBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#DCDFE6" />
            <SolidColorBrush x:Key="ToolTipForeground" Color="#1A1D24" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Geometry -->
    <CornerRadius x:Key="SfRadiusSmall">6</CornerRadius>
    <CornerRadius x:Key="SfRadiusControl">7</CornerRadius>
    <CornerRadius x:Key="SfRadiusPanel">9</CornerRadius>
    <CornerRadius x:Key="SfRadiusOverlay">12</CornerRadius>
    <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="OverlayCornerRadius">10</CornerRadius>

    <!-- Spacing scale: 2 · 4 · 6 · 8 · 12 · 16 · 24 -->
    <x:Double x:Key="SfSpace1">2</x:Double>
    <x:Double x:Key="SfSpace2">4</x:Double>
    <x:Double x:Key="SfSpace3">6</x:Double>
    <x:Double x:Key="SfSpace4">8</x:Double>
    <x:Double x:Key="SfSpace5">12</x:Double>
    <x:Double x:Key="SfSpace6">16</x:Double>
    <x:Double x:Key="SfSpace7">24</x:Double>

    <x:Double x:Key="SfTitleBarHeight">44</x:Double>
    <x:Double x:Key="SfStatusBarHeight">26</x:Double>
    <x:Double x:Key="SfControlHeight">30</x:Double>

    <!-- Typography -->
    <FontFamily x:Key="SfIconFont">Segoe Fluent Icons,Segoe MDL2 Assets</FontFamily>
    <x:Double x:Key="SfFontCaption">12</x:Double>
    <x:Double x:Key="SfFontBody">13</x:Double>
    <x:Double x:Key="SfFontSubtitle">15</x:Double>
    <x:Double x:Key="SfFontTitle">20</x:Double>
</ResourceDictionary>
