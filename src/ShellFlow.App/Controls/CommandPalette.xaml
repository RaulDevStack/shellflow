<UserControl
    x:Class="ShellFlow.App.Controls.CommandPalette"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ShellFlow.App.Controls">

    <Grid x:Name="Scrim" Background="Transparent" Tapped="OnScrimTapped">
        <Grid
            x:Name="Card"
            Width="620"
            MaxHeight="460"
            Margin="16,52,16,16"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{ThemeResource SfSurfaceElevatedBrush}"
            BorderBrush="{ThemeResource SfBorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource SfRadiusOverlay}"
            Tapped="OnCardTapped">
            <Grid.Shadow>
                <ThemeShadow />
            </Grid.Shadow>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Padding="14,4,10,4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource SfIconFont}"
                    FontSize="14"
                    Foreground="{ThemeResource SfTextSecondaryBrush}"
                    Glyph="&#xE721;" />
                <TextBox
                    x:Name="QueryBox"
                    Grid.Column="1"
                    MinHeight="40"
                    Padding="2,10,2,8"
                    AutomationProperties.Name="Command palette search"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="14"
                    PlaceholderText="Type a command…"
                    PreviewKeyDown="OnQueryPreviewKeyDown"
                    TextChanged="OnQueryChanged">
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    </TextBox.Resources>
                </TextBox>
                <Border
                    x:Name="ModeChip"
                    Grid.Column="2"
                    Padding="8,2"
                    VerticalAlignment="Center"
                    Background="{ThemeResource SfAccentSubtleBrush}"
                    CornerRadius="5"
                    Visibility="Collapsed">
                    <TextBlock x:Name="ModeText" FontSize="11.5" Foreground="{ThemeResource SfAccentBrush}" />
                </Border>
            </Grid>

            <Rectangle Grid.Row="1" Height="1" Fill="{ThemeResource SfBorderSubtleBrush}" />

            <ListView
                x:Name="Results"
                Grid.Row="2"
                Padding="0,6"
                AutomationProperties.Name="Commands"
                IsItemClickEnabled="True"
                ItemClick="OnResultClicked"
                ItemContainerStyle="{StaticResource SfListRowStyle}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:PaletteItem">
                        <Grid ColumnSpacing="12" AutomationProperties.Name="{x:Bind AutomationName}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                VerticalAlignment="Center"
                                FontFamily="{StaticResource SfIconFont}"
                                FontSize="14"
                                Foreground="{ThemeResource SfTextSecondaryBrush}"
                                Glyph="{x:Bind Glyph}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                                <TextBlock FontSize="13" Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="11.5"
                                    Foreground="{ThemeResource SfTextTertiaryBrush}"
                                    Text="{x:Bind Subtitle}"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{x:Bind SubtitleVisibility}" />
                            </StackPanel>
                            <Border
                                Grid.Column="2"
                                Padding="7,2"
                                VerticalAlignment="Center"
                                Background="{ThemeResource SfShortcutChipBrush}"
                                CornerRadius="5"
                                Visibility="{x:Bind ShortcutVisibility}">
                                <TextBlock Style="{StaticResource SfShortcutChipTextStyle}" Text="{x:Bind Shortcut}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                x:Name="EmptyText"
                Grid.Row="2"
                Margin="0,24"
                HorizontalAlignment="Center"
                Foreground="{ThemeResource SfTextSecondaryBrush}"
                Text="No matching commands"
                Visibility="Collapsed" />

            <Grid Grid.Row="3" Padding="14,8" BorderBrush="{ThemeResource SfBorderSubtleBrush}" BorderThickness="0,1,0,0">
                <TextBlock Style="{StaticResource SfStatusTextStyle}" Foreground="{ThemeResource SfTextTertiaryBrush}" Text="↑ ↓ to navigate   ·   Enter to run   ·   Esc to close" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
