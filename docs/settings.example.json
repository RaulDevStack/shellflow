{
  // Copy the parts you need into %LOCALAPPDATA%\ShellFlow\settings.json.
  // Comments and trailing commas are allowed. Invalid values are corrected on load and reported in the app.
  "schemaVersion": 1,
  "defaultProfileId": "windows-powershell",
  "defaultStartingDirectory": "%USERPROFILE%\\source",
  "terminal": {
    "fontFamily": "Cascadia Mono, Consolas, monospace",
    "fontSize": 13,
    "lineHeight": 1.2,
    "cursorStyle": "Bar",          // Bar | Block | Underline
    "cursorBlink": true,
    "scrollback": 10000,           // 0 – 100000
    "gpuAcceleration": true,
    "copyOnSelect": false
  },
  "appearance": {
    "theme": "Dark",               // Dark | Light | System
    "accent": "Periwinkle",        // Periwinkle | Sky | Mint | Peach
    "animations": "System",        // System | Full | Off
    "motionStyle": "Fluid"         // Fluid (Hyprland-like) | Subtle
  },
  "behavior": {
    "confirmCloseRunning": true,
    "confirmMultilinePaste": true,
    "closeOnCleanExit": true
  },
  "profiles": [
    {
      // ids: lowercase letters, digits, '.', '_' or '-'. Reusing a detected id (e.g. "cmd") overrides that shell.
      "id": "pwsh-dev",
      "name": "PowerShell (dev)",
      "executable": "pwsh.exe",
      "arguments": "-NoLogo -NoExit -Command \"Set-Location ~/source\"",
      "startingDirectory": "%USERPROFILE%\\source",
      "environment": { "DOTNET_CLI_TELEMETRY_OPTOUT": "1" },
      "icon": "powershell",          // terminal | powershell | cmd | bash | linux
      "accent": "#A6B7FF"
    }
  ],
  "keyBindings": {
    // command id → chord; several chords with " | "; "" unbinds the default.
    "pane.splitRight": "Ctrl+Alt+D",
    "terminal.paste": "Ctrl+Shift+V | Shift+Insert"
  }
}
