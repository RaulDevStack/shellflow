<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <Version>0.1.0</Version>
    <Authors>ShellFlow contributors</Authors>
    <Product>ShellFlow</Product>
    <Copyright>Copyright (c) ShellFlow contributors</Copyright>
    <Description>ShellFlow — Your terminal. In flow.</Description>
    <!-- Pinned so every WinUI project agrees on the Windows App SDK servicing release. -->
    <ShellFlowWindowsAppSdkVersion>1.8.260921001</ShellFlowWindowsAppSdkVersion>
    <ShellFlowWindowsSdkBuildToolsVersion>10.0.28000.2705</ShellFlowWindowsSdkBuildToolsVersion>
    <ShellFlowWinTfm>net10.0-windows10.0.19041.0</ShellFlowWinTfm>
  </PropertyGroup>
</Project>
